<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Raw UDP and one HTTPS relay call. No cleartext HTTP is used for
         anything but LAN pairing, which is covered below. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Doze suspends app threads regardless of socket state, which would lapse
         both the 500 ms media keepalive and the 25 s STUN keepalive and drop the
         NAT mapping. A foreground service is the sanctioned way to keep them
         running while the screen is off or the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Echo"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- resizeableActivity is what makes the window eligible for desktop
             mode and secondary displays at all; several OEM implementations
             refuse to place a non-resizeable activity on an external display,
             which is why the app would not appear on the glasses. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:preferMinimalPostProcessing="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation|touchscreen|layoutDirection|fontScale"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the keepalive threads scheduled while Echo is backgrounded.
             mediaPlayback is the honest type: this process is decoding and
             presenting a live video stream. -->
        <service
            android:name=".EchoService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
