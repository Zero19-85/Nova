<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: two pulse arcs radiating left of a solid node.
     All content sits inside a 36-unit radius of the 54,54 centre, so the
     circular mask (the tightest one launchers apply) cannot clip any of it —
     the outer 18 units on each edge are reserved for mask + parallax and are
     deliberately left empty.

     The arc paths carry strokeColor with no fillColor: VectorDrawable defaults
     fill to none, so these stay open arcs rather than filled wedges. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:strokeColor="#00E5FF" android:strokeWidth="6" android:strokeLineCap="round"
        android:pathData="M 34,74 A 40,40 0 0,1 34,34" />
    <path android:strokeColor="#00E5FF" android:strokeWidth="6" android:strokeLineCap="round"
        android:pathData="M 46,66 A 28,28 0 0,1 46,42" />
    <path android:fillColor="#00E5FF"
        android:pathData="M 64,54 m -8,0 a 8,8 0 1,1 16,0 a 8,8 0 1,1 -16,0" />
</vector>
