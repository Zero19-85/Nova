<?xml version="1.0" encoding="utf-8"?>
<!--
  Restored on first build (or by `nuget restore` / VS's automatic restore).
  C++/WinRT ships as a NuGet package rather than as part of the SDK: it is what
  generates the projected headers under Generated Files\winrt\ that pch.h
  includes, so a missing restore presents as thousands of "cannot open source
  file winrt/..." errors rather than as a package error.
-->
<packages>
  <package id="Microsoft.Windows.CppWinRT" version="2.0.250303.1" targetFramework="native" />
</packages>
