<Application
    x:Class="EchoXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoXbox">
    <Application.Resources>
        <!-- A TV is viewed from three metres, so nothing here uses the default
             desktop type ramp. -->
        <x:Double x:Key="EchoBodySize">22</x:Double>
        <x:Double x:Key="EchoTitleSize">44</x:Double>
    </Application.Resources>
</Application>
