<Application
    x:Class="EchoXbox.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoXbox"
    RequestedTheme="Dark">
    <!--
      Dark is stated rather than inherited. A console follows the system theme,
      and a light-theme console would hand every stock control a white ground
      and near-black text — over a video stream, on a palette whose whole point
      is an unlit background. The Ion overrides in Ion.xaml set colours, not
      theme, so without this the app is one system setting away from wrong.
    -->
    <Application.Resources>
        <!-- Everything lives in Ion.xaml — the palette, the TV type ramp, and
             the lightweight overrides that restyle the stock controls. A key
             defined BOTH here and there is a runtime XamlParseException rather
             than a compile error, so this dictionary is deliberately empty of
             anything but the merge. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ion.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
