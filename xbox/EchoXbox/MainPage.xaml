<Page
    x:Class="EchoXbox.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EchoXbox"
    Background="#0B0C10">

    <Grid>
        <!-- The video surface. Everything else floats above it, so a running
             stream always has the whole screen and nothing is composited over
             it unless somebody asked for it. -->
        <SwapChainPanel x:Name="VideoPanel"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />

        <!-- ===== The dashboard: what you see before a stream starts ======== -->
        <Grid x:Name="SetupRoot" Margin="96,64">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Echo"
                               Foreground="#E8EDF2"
                               FontSize="{StaticResource EchoTitleSize}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusLine"
                               Text="starting…"
                               Foreground="#00E5FF"
                               FontSize="{StaticResource EchoBodySize}"
                               Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <Button x:Name="RescanButton" Content="Rescan" FontSize="20"
                            Padding="20,8" Click="OnRescanClick" />
                    <Button x:Name="SettingsButton" Content="Settings" FontSize="20"
                            Padding="20,8" Click="OnSettingsClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Known hosts. Gamepad reaches this by focus. -->
                <Border Grid.Column="0" CornerRadius="12" Background="#C8060809" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   x:Name="HostsHeader"
                                   Text="Searching the network…"
                                   Foreground="#8A94A6"
                                   FontSize="20"
                                   Margin="0,0,0,14" />

                        <!-- Items are built in code: a DataTemplate with x:Bind
                             would need a WinRT runtimeclass per row, which is a
                             lot of projection machinery for three lines. -->
                        <ListView Grid.Row="1"
                                  x:Name="HostList"
                                  SelectionMode="Single"
                                  SelectionChanged="OnHostSelectionChanged" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12"
                                    Margin="0,18,0,0">
                            <Button x:Name="StreamButton" Content="Stream" FontSize="22"
                                    Padding="30,10" IsEnabled="False" Click="OnStreamClick" />
                            <Button x:Name="PairButton" Content="Pair" FontSize="22"
                                    Padding="26,10" IsEnabled="False" Click="OnPairClick" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The PIN, and the diagnostics nobody needs until they do. -->
                <Border Grid.Column="2" CornerRadius="12" Background="#C8060809" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" x:Name="PinPanel" Visibility="Collapsed"
                                    Margin="0,0,0,20">
                            <TextBlock Text="Type this PIN into Nova on the PC"
                                       Foreground="#8A94A6" FontSize="20" />
                            <TextBlock x:Name="PinText"
                                       Text="----"
                                       Foreground="#00E5FF"
                                       FontFamily="Consolas"
                                       FontSize="72"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" x:Name="LogScroller"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="LogText"
                                       Text=""
                                       Foreground="#7C879A"
                                       FontFamily="Consolas"
                                       FontSize="15"
                                       TextWrapping="Wrap"
                                       LineHeight="22" />
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ===== Streaming ==================================================
             There is deliberately nothing here. While a stream is running the
             page is the picture and nothing else; the panel below exists only
             while somebody is holding it open. -->

        <!-- ===== No picture yet ============================================
             Shown only while a session is live and nothing has ever been
             drawn. A blank field with no explanation is how ten sessions in a
             row failed silently; the counters were already being kept, they
             were just hidden behind a button nobody had reason to press. -->
        <Border x:Name="NoVideoPanel"
                Visibility="Collapsed"
                CornerRadius="10"
                Background="#C8060809"
                Padding="32,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="10">
                <TextBlock
                           Text="Waiting for video"
                           Foreground="#E8EDF2"
                           FontSize="28"
                           FontWeight="SemiBold" />
                <TextBlock x:Name="NoVideoText"
                           Text=""
                           Foreground="#8A94A6"
                           FontFamily="Consolas"
                           FontSize="17"
                           LineHeight="26" />
            </StackPanel>
        </Border>

        <!-- ===== The overlay: hold VIEW for 700 ms ========================== -->
        <Grid x:Name="OverlayRoot" Visibility="Collapsed" Background="#B4030405">
            <Border CornerRadius="14"
                    Background="#F00B0C10"
                    BorderBrush="#3300E5FF"
                    BorderThickness="1"
                    Padding="40,32"
                    MinWidth="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <StackPanel>
                        <TextBlock Text="Echo"
                                   Foreground="#E8EDF2"
                                   FontSize="34"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="OverlaySubtitle"
                                   Text=""
                                   Foreground="#8A94A6"
                                   FontSize="19"
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Resolution"
                                   Foreground="#8A94A6" FontSize="17" />
                        <!-- Changing this mid-stream re-modes the host display
                             live; it does not restart the session. -->
                        <StackPanel x:Name="ResolutionRow" Orientation="Horizontal" Spacing="10" />
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Frame rate"
                                   Foreground="#8A94A6" FontSize="17" />
                        <StackPanel x:Name="FrameRateRow" Orientation="Horizontal" Spacing="10" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                        <Button x:Name="ResumeButton" Content="Back to the stream"
                                FontSize="21" Padding="26,10" Click="OnResumeClick" />
                        <Button x:Name="DisconnectButton" Content="Disconnect"
                                FontSize="21" Padding="26,10" Click="OnStopClick" />
                        <Button x:Name="DiagnosticsButton" Content="Diagnostics"
                                FontSize="21" Padding="26,10" Click="OnDiagnosticsClick" />
                    </StackPanel>

                    <!-- The old always-on strip, now something you ask for.
                         The first zero still names the stage that is stuck. -->
                    <TextBlock x:Name="DiagnosticsText"
                               Visibility="Collapsed"
                               Foreground="#7C879A"
                               FontFamily="Consolas"
                               FontSize="16"
                               TextWrapping="Wrap"
                               LineHeight="24" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
