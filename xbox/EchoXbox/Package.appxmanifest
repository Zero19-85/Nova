<?xml version="1.0" encoding="utf-8"?>
<!--
  Echo for Xbox — package manifest.

  Three things here are load-bearing and easy to get wrong:

  1. THE CAPABILITIES ARE THE NETWORK. A UWP app with none of them gets a
     socket that binds and then silently reaches nothing, which looks exactly
     like a host that is switched off. `internetClientServer` is what permits
     INBOUND datagrams — Echo's whole transport is a UDP hole punch, so
     `internetClient` alone would let the punch leave and drop every reply.
     `privateNetworkClientServer` is the LAN half of the same story and is what
     the LAN-direct cascade and any mDNS discovery need.

  2. `microphone` is a DeviceCapability, and on a console it gates the headset.
     Declared here it produces a one-time consent prompt, not a silent failure —
     but a mic that is never opened costs the user nothing, so it stays.

  3. TargetDeviceFamily is `Windows.Universal`, not `Windows.Xbox`. The Xbox
     family exists but narrows the app to that device; Universal runs on the
     console AND on the dev box, which is the difference between debugging this
     on a PC and only ever debugging it on a TV. A `Windows.Xbox` entry sits
     BESIDE it for the Store submission: beside, never instead of.

  4. `hevcPlayback` is what makes the console OFFER HDR10 display modes, and
     that is the only reason it is here. MEASURED 2026-10-15 on the same
     Series X and TV, running as Game in both cases: without it,
     HdmiDisplayInformation::GetSupportedDisplayModes listed only
     `3840x2160 @ 59.94/119.88 Hz, 24 bpp, RGB limited`, PQ raw 0x00, with no
     10-bit and no PQ entries at all. With it, the same call also listed
     `30 bpp BT2020 (PQ capable)` at both rates (HANDOFF_ECHO_XBOX.md 14.6,
     18.2). It does NOT gate the decoder (Echo uses FFmpeg/D3D11VA into a
     swap chain), and memory is not the reason either: 686 MB peak measured,
     under the 1.25 GB a plain app gets. Store certification rejected it
     once under Policy 10.6.3 (2026-10-15); it is back pending
     reconsideration with that measured evidence. Removing it costs HDR10,
     not 4K.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap mp rescap">

  <!-- The Partner Center reservation "Echo Stream Client" (2026-10-11).
       Name, Publisher and PublisherDisplayName must equal Product identity
       character for character, or the upload is refused. Publisher is ALSO the
       subject of the sideload certificate: build-app.ps1 reads it from here,
       so a change here needs `build-app.ps1 -NewCert` once. -->
  <Identity
    Name="Zeroorigin1985.com.EchoStreamClient"
    Publisher="CN=966F1B4F-E0AA-49A8-86CD-B67FF919632A"
    Version="0.1.3.1" />

  <mp:PhoneIdentity PhoneProductId="6f1c2a10-4e9c-4d5f-9a3f-0d4c6b7e8a01"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Echo Stream Client</DisplayName>
    <PublisherDisplayName>Zero@origin1985.com</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 (1809) is the floor the Xbox One generation shipped against;
         raising it buys nothing Echo uses and drops hardware for no reason. -->
    <TargetDeviceFamily Name="Windows.Universal"
                        MinVersion="10.0.17763.0"
                        MaxVersionTested="10.0.26100.0" />
    <!-- The Store submission's console entry. The more specific family wins
         on a device that matches both, so this is what the console reads;
         Universal above keeps the package installable on the dev box. -->
    <TargetDeviceFamily Name="Windows.Xbox"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="EchoXbox.App">
      <uap:VisualElements
        DisplayName="Echo Stream Client"
        Description="Nova's native client"
        BackgroundColor="#050508"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Outbound to the relay and the host over the internet. -->
    <Capability Name="internetClient" />
    <!-- INBOUND datagrams. Without this the hole punch is one-way and every
         reply is dropped by the container, not by the network. -->
    <Capability Name="internetClientServer" />
    <!-- The LAN half: the direct rendezvous, and discovery if it is added. -->
    <Capability Name="privateNetworkClientServer" />
    <!-- HDR10 display modes. See note 4. Restricted: a Store build needs it
         approved. Must precede DeviceCapability. -->
    <rescap:Capability Name="hevcPlayback" />
    <!-- Headset microphone, for upstream passthrough. -->
    <DeviceCapability Name="microphone" />
  </Capabilities>
</Package>
