<!--
  "Ion Cyber-Terminal" — the one place colour is decided, kept in step with the
  Android client's `Theme.kt` so the two clients are recognisably one product.

  ── What changed, and why it is not a repaint ────────────────────────────────

  Two decisions here are functional before they are aesthetic, and both are
  about the television this app is read from:

  1. **The ground is #000000, not a dark grey.** A Mini-LED or OLED panel turns
     its backlight OFF for a truly black pixel; #050508 is *nearly* black and
     keeps every dimming zone under the UI lit at its floor. On a screen that
     surrounds someone else's desktop that difference is visible as a grey haze
     framing the picture. Pure black is what makes the chrome disappear and the
     video the only lit thing on the wall. Nothing that fills a large area may
     be anything else.

  2. **Two accents, on an absolute black field.** Ion was one cyan doing every
     job — focus, selection, live state, telemetry — and on black a single hue
     gives a screen no depth at all. The two now split the work, and the rule
     is worth learning because everything below follows it:

       Ion Yellow (#FFF200)   WHERE YOU ARE and WHAT YOU CHOSE. Focus, the
                              selected item, the active mode, the app's own
                              voice. If the user's thumb put it there, it is
                              yellow.
       Ion Blue (#2B8CFF)     WHAT IS HAPPENING NOW. A live stream, a running
                              session, a number that is still moving. State the
                              app is reporting rather than offering.
       Matrix (green)         THE NETWORK ANSWERED — a host on this LAN, a
                              healthy probe, a low round trip. Nothing else is
                              allowed to be green. (Unchanged, and the reason
                              the yellow above is a true yellow rather than the
                              chartreuse that "neon yellow" usually means: at
                              three metres a green-shifted yellow and Matrix
                              green are the same colour.)

  ── The type ramp is authored at 4K, and that is new ────────────────────────

  Every size below is in the 3840x2160 design space `MainPage` lays out in —
  roughly 1.6x the old 1080p-space numbers, NOT 2x. That ratio is the whole
  point of the rescale: at 2x the UI would be pixel-for-pixel what it was and
  the boxes would still be enormous, and at 1x it would be half the physical
  size and unreadable from a sofa. 1.6x puts the chrome at about 80% of its old
  physical size — denser, more on screen, and still above the ten-foot floor
  (~24 px measured in the 1080p space, which is 38 here).

  `MainPage::ApplyChromeScale` is what makes that space real on hardware that
  will not hand the app native pixels; see the note there.

  ── Why the system brush keys are overridden here ─────────────────────────
  A UWP Button's hover, pressed and focus appearance comes from its template's
  VisualStateManager, which reads theme resources by key. Setting Background in
  a Style therefore restyles the rest state and nothing else — the button turns
  grey again the moment it takes focus, which on a console is most of the time.
  Overriding the keys themselves ("lightweight styling") is what makes every
  state consistent, and it does it without replacing a single ControlTemplate —
  so the console's own focus behaviour, which gamepad navigation depends on
  entirely, is left exactly as Microsoft shipped it.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== The palette ================================================= -->
    <!-- Pure black. See note 1 above: this is the local-dimming decision, and
         it is the one colour here that must not be "adjusted slightly". -->
    <Color x:Key="IonVoidColor">#FF000000</Color>
    <!-- Card surfaces, darkened to match the new ground. They are small and
         bounded, so they may be lit; a card at the old #101318 on a #000000
         field reads as a grey rectangle rather than as a raised surface. -->
    <Color x:Key="IonCarbonColor">#FF0B0E14</Color>
    <Color x:Key="IonCarbonLightColor">#FF141922</Color>
    <Color x:Key="IonEdgeColor">#FF232B3D</Color>

    <!-- The two accents. -->
    <Color x:Key="IonAccentColor">#FFFFF200</Color>
    <Color x:Key="IonBlueColor">#FF2B8CFF</Color>

    <Color x:Key="IonMatrixColor">#FF00FF66</Color>
    <Color x:Key="IonAmberColor">#FFFFB020</Color>
    <Color x:Key="IonCrimsonColor">#FFFF3355</Color>
    <Color x:Key="IonTextColor">#FFE6EDF3</Color>
    <Color x:Key="IonTextDimColor">#FF7D8BA1</Color>

    <SolidColorBrush x:Key="IonVoid" Color="{StaticResource IonVoidColor}" />
    <SolidColorBrush x:Key="IonCarbon" Color="{StaticResource IonCarbonColor}" />
    <SolidColorBrush x:Key="IonCarbonLight" Color="{StaticResource IonCarbonLightColor}" />
    <SolidColorBrush x:Key="IonEdge" Color="{StaticResource IonEdgeColor}" />
    <SolidColorBrush x:Key="IonAccent" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="IonBlue" Color="{StaticResource IonBlueColor}" />
    <SolidColorBrush x:Key="IonMatrix" Color="{StaticResource IonMatrixColor}" />
    <SolidColorBrush x:Key="IonAmber" Color="{StaticResource IonAmberColor}" />
    <SolidColorBrush x:Key="IonCrimson" Color="{StaticResource IonCrimsonColor}" />
    <SolidColorBrush x:Key="IonText" Color="{StaticResource IonTextColor}" />
    <SolidColorBrush x:Key="IonTextDim" Color="{StaticResource IonTextDimColor}" />

    <!-- Scrims. The overlay sits over live video, so its ground is a wash
         rather than a fill: the picture stays visible underneath, which is
         what tells a user the stream did not stop. Now washing towards pure
         black, like everything else. -->
    <SolidColorBrush x:Key="IonScrim" Color="#D2000000" />
    <SolidColorBrush x:Key="IonPanel" Color="#F70B0E14" />
    <SolidColorBrush x:Key="IonAccentWash" Color="#1FFFF200" />
    <SolidColorBrush x:Key="IonAccentEdge" Color="#8CFFF200" />
    <SolidColorBrush x:Key="IonBlueWash" Color="#1F2B8CFF" />
    <SolidColorBrush x:Key="IonBlueEdge" Color="#8C2B8CFF" />

    <!-- ===== The TV type ramp, in the 4K design space ==================== -->
    <x:Double x:Key="EchoTelemetrySize">26</x:Double>
    <x:Double x:Key="EchoLabelSize">28</x:Double>
    <x:Double x:Key="EchoBodySize">36</x:Double>
    <x:Double x:Key="EchoHeadingSize">44</x:Double>
    <x:Double x:Key="EchoTitleSize">70</x:Double>
    <x:Double x:Key="EchoPinSize">116</x:Double>

    <!-- 10, which is the old 6 in the new space. The Ion look is
         terminal-sharp; a soft radius reads as a different product. -->
    <CornerRadius x:Key="EchoCardRadius">10</CornerRadius>

    <!-- ===== Killing the system accent ================================== -->
    <!--
      Overriding the individual `Button*` / `ListViewItem*` keys below restyles
      the controls this app names. It does NOT reach everything: a XAML control
      template can also reference `SystemAccentColor` and its six shades
      directly, and on a console that is where Microsoft blue keeps coming back
      — a focus rect here, a selected-row fill there, a scroll thumb, the
      ProgressRing. Chasing those one key at a time is a losing game because
      the list is template-private and changes between SDK versions.

      Redefining the accent colour ITSELF is the one lever that reaches all of
      them at once, including the controls this app has not used yet. Ion
      yellow is the accent for the whole application; nothing derives from
      Microsoft blue any more because Microsoft blue is no longer defined.

      The Light/Dark shades are the accent lightened and darkened. XAML picks
      between them per control and per visual state, so they must ALL be
      Ion-derived — leaving one at its default is how a single blue hover state
      survives a purge and takes a session to find.
    -->
    <Color x:Key="SystemAccentColor">#FFFFF200</Color>
    <Color x:Key="SystemAccentColorLight1">#FFFFF54D</Color>
    <Color x:Key="SystemAccentColorLight2">#FFFFF880</Color>
    <Color x:Key="SystemAccentColorLight3">#FFFFFBB3</Color>
    <Color x:Key="SystemAccentColorDark1">#FFCFC400</Color>
    <Color x:Key="SystemAccentColorDark2">#FF9E9600</Color>
    <Color x:Key="SystemAccentColorDark3">#FF6E6800</Color>

    <!-- Text drawn ON the accent. The accent is a bright yellow, so white on it
         is unreadable — this is the one place near-black is correct. -->
    <SolidColorBrush x:Key="SystemControlForegroundAltHighBrush" Color="{StaticResource IonVoidColor}" />

    <!-- ===== The page ground, taken away from the theme ================== -->
    <!--
      A Page's and a Frame's default Background is `ApplicationPageBackgroundThemeBrush`,
      which in the dark theme is a lifted near-black (#FF000000 is NOT what
      ships — it is a chrome grey). Setting Background on the Page reaches the
      Page; it does not reach the Frame the Page is hosted in, the ContentPresenter
      inside it, or anything else that quietly asks the theme for a ground. Each
      of those is a full-screen rectangle, so exactly one of them left at the
      default is enough to keep a Mini-LED panel's dimming zones lit.

      Overriding the KEY is what reaches all of them at once, including the ones
      this app has not put on screen yet. The four below are the page-shaped
      grounds a XAML container picks up without being asked.

      This is defence in depth rather than the actual fix. The pixels the user
      sees on the dashboard come from the SWAP CHAIN, which is stretched over
      the whole window above every one of these brushes — see the clear colour
      in VideoRenderer.cpp, which is where a "the background is not black" report
      is answered first.
    -->
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush" Color="{StaticResource IonVoidColor}" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundAltHighBrush" Color="{StaticResource IonVoidColor}" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="{StaticResource IonVoidColor}" />
    <SolidColorBrush x:Key="SystemControlPageBackgroundBaseLowBrush" Color="{StaticResource IonVoidColor}" />

    <!-- ===== Lightweight styling of the stock controls =================== -->
    <SolidColorBrush x:Key="ButtonBackground" Color="{StaticResource IonCarbonLightColor}" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#26FFF200" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#4DFFF200" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#FF0A0C10" />
    <SolidColorBrush x:Key="ButtonForeground" Color="{StaticResource IonTextColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#FF445061" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource IonEdgeColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#FF141922" />

    <!-- Focus is the cursor on a console. Yellow, because focus is the purest
         case of "where you are" — see the rule at the top. -->
    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="{StaticResource IonVoidColor}" />

    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#26FFF200" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#33FFF200" />
    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#4DFFF200" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#FF141922" />
    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#26FFF200" />
    <SolidColorBrush x:Key="ListViewItemForeground" Color="{StaticResource IonTextColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="{StaticResource IonTextColor}" />
    <SolidColorBrush x:Key="ListViewItemForegroundPointerOver" Color="{StaticResource IonTextColor}" />
    <SolidColorBrush x:Key="ListViewItemFocusBorderBrush" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="ListViewItemFocusSecondaryBorderBrush" Color="{StaticResource IonVoidColor}" />

    <!-- The scroll bar on the diagnostics panel. Left at defaults it is the
         one grey-and-blue object on an otherwise Ion screen. Blue rather than
         yellow: a scroll position reports state, it is not a choice. -->
    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#802B8CFF" />
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="{StaticResource IonBlueColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbFillDisabled" Color="{StaticResource IonEdgeColor}" />
    <SolidColorBrush x:Key="ScrollBarTrackFill" Color="#FF0A0C10" />
    <SolidColorBrush x:Key="ScrollBarPanningThumbBackground" Color="#802B8CFF" />

    <!-- The mic slider. A slider carries a live value rather than a choice
         between alternatives, so its filled track is blue and only the thumb —
         the thing the stick is actually holding — is yellow. -->
    <SolidColorBrush x:Key="SliderTrackValueFill" Color="{StaticResource IonBlueColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="{StaticResource IonBlueColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillPressed" Color="{StaticResource IonBlueColor}" />
    <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="{StaticResource IonEdgeColor}" />
    <SolidColorBrush x:Key="SliderTrackFill" Color="#FF141922" />
    <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#FF1B2130" />
    <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#FF1B2130" />
    <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="{StaticResource IonAccentColor}" />
    <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="{StaticResource IonAccentColor}" />

    <!-- ===== Named styles ============================================== -->
    <Style x:Key="IonCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource IonCarbon}" />
        <Setter Property="BorderBrush" Value="{StaticResource IonEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource EchoCardRadius}" />
        <Setter Property="Padding" Value="38" />
    </Style>

    <Style x:Key="IonButton" TargetType="Button">
        <Setter Property="FontSize" Value="{StaticResource EchoBodySize}" />
        <Setter Property="Padding" Value="38,16,38,16" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- The one action on a panel that the user most likely came for. -->
    <Style x:Key="IonPrimaryButton" TargetType="Button" BasedOn="{StaticResource IonButton}">
        <Setter Property="Background" Value="{StaticResource IonAccentWash}" />
        <Setter Property="BorderBrush" Value="{StaticResource IonAccentEdge}" />
        <Setter Property="Foreground" Value="{StaticResource IonAccent}" />
    </Style>

    <!-- An icon button: square, quiet, and it belongs in a corner.
         90 in this space is the old 56 — a console cursor is a focus rect the
         user steers with a stick, and a target smaller than this is genuinely
         hard to land on from a sofa. -->
    <Style x:Key="IonIconButton" TargetType="Button" BasedOn="{StaticResource IonButton}">
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="90" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Segoe MDL2 Assets ships with Windows and with the console, so an icon
         costs no asset, no font file and nothing in the package. -->
    <Style x:Key="IonGlyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource IonTextDim}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- SELECTED, which is a different thing from PRIMARY.
         `IonPrimaryButton` marks the action you probably came for; this marks
         the option that is currently in force. They are deliberately not the
         same style: on the overlay both appear at once, and if "4K" and "Back
         to the stream" looked identical then the highlight would read as
         "press this" rather than "this is what you are running".

         Solid fill and a bold accent border, so it survives being next to a
         focus rect — on a console the selected item and the focused item are
         usually different items, and both have to be legible at three metres. -->
    <Style x:Key="IonActiveButton" TargetType="Button" BasedOn="{StaticResource IonButton}">
        <Setter Property="Background" Value="#33FFF200" />
        <Setter Property="BorderBrush" Value="{StaticResource IonAccent}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Foreground" Value="{StaticResource IonAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Destructive, and it is the only red thing on any panel. -->
    <Style x:Key="IonDangerButton" TargetType="Button" BasedOn="{StaticResource IonButton}">
        <Setter Property="Background" Value="#1AFF3355" />
        <Setter Property="BorderBrush" Value="#8CFF3355" />
        <Setter Property="Foreground" Value="{StaticResource IonCrimson}" />
    </Style>

    <!-- A full-width row in one of the pop-up menus. Those are read top to
         bottom from a sofa, so the label is left-aligned and the button is as
         wide as the panel rather than as wide as its text — a column of
         ragged-width buttons is much harder to run a focus rect down. -->
    <Style x:Key="IonMenuButton" TargetType="Button" BasedOn="{StaticResource IonButton}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="30,20,30,20" />
    </Style>

    <!-- Monospace everywhere a number, an address or a hash appears.
         Proportional digits jitter as a value changes, and a latency figure
         that dances while it updates is genuinely harder to read. -->
    <Style x:Key="IonTelemetry" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="{StaticResource EchoTelemetrySize}" />
        <Setter Property="Foreground" Value="{StaticResource IonTextDim}" />
        <Setter Property="LineHeight" Value="38" />
    </Style>

    <Style x:Key="IonLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource EchoLabelSize}" />
        <Setter Property="Foreground" Value="{StaticResource IonTextDim}" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>

    <Style x:Key="IonHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource EchoHeadingSize}" />
        <Setter Property="Foreground" Value="{StaticResource IonText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
