<?xml version="1.0" encoding="utf-8"?>
<!--
  Echo for Xbox — a C++/WinRT UWP application.

  Written against the Visual Studio "Blank App (C++/WinRT)" template shape. Four
  properties here are what make it a UWP app rather than a desktop one, and all
  four must agree or the failure is a confusing link error rather than a clear
  configuration one:

    ApplicationType          = Windows Store
    ApplicationTypeRevision  = 10.0
    AppContainerApplication  = true      (links /APPCONTAINER, sets the manifest)
    WindowsAppContainer      = true

  x64 only, on purpose. Xbox One and Series are x64; ARM64 and x86 would be dead
  configurations that only ever break silently.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="..\packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props" Condition="Exists('..\packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props')" />

  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>true</CppWinRTGenerateWindowsMetadata>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{4E43484F-5842-4F58-9000-000000000001}</ProjectGuid>
    <ProjectName>EchoXbox</ProjectName>
    <RootNamespace>EchoXbox</RootNamespace>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <WindowsTargetPlatformVersion>10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.17763.0</WindowsTargetPlatformMinVersion>
    <AppContainerApplication>true</AppContainerApplication>
    <WindowsAppContainer>true</WindowsAppContainer>
    <PackageCertificateKeyFile>EchoXbox_TemporaryKey.pfx</PackageCertificateKeyFile>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <PlatformToolset>v143</PlatformToolset>
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
    <LinkIncremental>true</LinkIncremental>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <LinkIncremental>false</LinkIncremental>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <PrecompiledHeaderOutputFile>$(IntDir)pch.pch</PrecompiledHeaderOutputFile>
      <!-- C++17 is what the C++/WinRT projection requires; /permissive- because
           the generated headers assume conforming two-phase lookup. -->
      <LanguageStandard>stdcpp17</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>%(AdditionalOptions) /bigobj /await</AdditionalOptions>
      <DisableSpecificWarnings>28204</DisableSpecificWarnings>
      <!-- `_VSDESIGNER_DONT_LOAD_AS_DLL` is NOT optional, and the failure it
           prevents is unhelpful. The XAML compiler's generated
           `XamlTypeInfo.g.cpp` otherwise emits `VSDesignerCanUnloadNow` and
           `VSDesignerDllGetActivationFactory` — entry points that exist purely
           so the Visual Studio XAML *designer* can load the app as a DLL. They
           call `WINRT_CanUnloadNow`/`WINRT_GetActivationFactory`, which current
           C++/WinRT does not define for an executable, so the app links only
           if those stubs are never generated. An Xbox app is never loaded by
           the designer, so nothing is lost.
           Symptom without it: LNK2019 on both symbols, from XamlTypeInfo.g.obj. -->
      <PreprocessorDefinitions>_VSDESIGNER_DONT_LOAD_AS_DLL;WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Where the Rust bridge's header lives, so `#include "EchoBridge.h"`
           works from any source file in the project. -->
      <AdditionalIncludeDirectories>$(ProjectDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- WindowsApp.lib is the UWP umbrella import library and comes from the
           Store toolset; `echo_xbox.dll.lib` is the Rust bridge's import lib,
           copied in by xbox\build-bridge.ps1. The DLL itself is packaged below
           as DeploymentContent. -->
      <AdditionalDependencies>echo_xbox.dll.lib;d3d11.lib;dxgi.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(ProjectDir)bridge;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="App.cpp">
      <DependentUpon>App.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="MainPage.cpp">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </ClCompile>
    <ClCompile Include="VideoRenderer.cpp" />
    <ClCompile Include="HevcDecoder.cpp" />
    <ClCompile Include="EchoSession.cpp" />
    <ClCompile Include="HostDiscovery.cpp" />
    <ClCompile Include="InputBridge.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="pch.h" />
    <ClInclude Include="EchoBridge.h" />
    <ClInclude Include="GamepadInput.h" />
    <ClInclude Include="VideoRenderer.h" />
    <ClInclude Include="HevcDecoder.h" />
    <ClInclude Include="EchoSession.h" />
    <ClInclude Include="HostDiscovery.h" />
    <ClInclude Include="InputBridge.h" />
    <ClInclude Include="App.h">
      <DependentUpon>App.xaml</DependentUpon>
    </ClInclude>
    <ClInclude Include="MainPage.h">
      <DependentUpon>MainPage.xaml</DependentUpon>
    </ClInclude>
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <SubType>Designer</SubType>
    </ApplicationDefinition>
    <Page Include="MainPage.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <ItemGroup>
    <Midl Include="MainPage.idl">
      <DependentUpon>MainPage.xaml</DependentUpon>
      <SubType>Code</SubType>
    </Midl>
  </ItemGroup>

  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="packages.config" />
    <None Include="EchoXbox_TemporaryKey.pfx" />
  </ItemGroup>

  <ItemGroup>
    <!-- THE RUST BRIDGE. `DeploymentContent` is what puts the DLL inside the
         .appx; without it the app builds, deploys, and fails at first launch
         with a missing-dependency error that names nothing useful. -->
    <None Include="bridge\echo_xbox.dll">
      <DeploymentContent>true</DeploymentContent>
      <ExcludedFromBuild>false</ExcludedFromBuild>
      <!-- `Link` is what puts the DLL at the package ROOT rather than at
           `bridge\echo_xbox.dll` inside the .msix. It is load-bearing: the
           Windows loader resolves an implicitly-linked DLL from the application
           directory, and does not search subfolders. Without this the package
           builds, deploys, and dies at launch with a missing-dependency error
           that names the app rather than the DLL. Verified from the package
           listing, not assumed — the first build put it in `bridge/`. -->
      <Link>echo_xbox.dll</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Image Include="Assets\SplashScreen.png" />
    <Image Include="Assets\Square150x150Logo.png" />
    <Image Include="Assets\Square44x44Logo.png" />
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\Wide310x150Logo.png" />
  </ItemGroup>

  <!-- Fail the build with a sentence rather than 200 link errors when somebody
       opens the solution before running the bridge build. This is the single
       most likely first-run mistake. -->
  <Target Name="EchoCheckBridge" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(ProjectDir)bridge\echo_xbox.dll.lib')"
           Text="The Rust bridge has not been built. Run: powershell -File ..\build-bridge.ps1  (from xbox\EchoXbox) — it builds echo-xbox with a static CRT and copies echo_xbox.dll/.lib into xbox\EchoXbox\bridge\." />
  </Target>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
    <Import Project="..\packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.targets" Condition="Exists('..\packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.targets')" />
  </ImportGroup>

  <Target Name="EnsureNuGetPackageBuildImports" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ErrorText>This project references NuGet package(s) that are missing on this computer. Enable NuGet Package Restore, or run `nuget restore` in xbox\. The missing file is {0}.</ErrorText>
    </PropertyGroup>
    <Error Condition="!Exists('..\packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props')" Text="$([System.String]::Format('$(ErrorText)', '..\packages\Microsoft.Windows.CppWinRT.2.0.250303.1\build\native\Microsoft.Windows.CppWinRT.props'))" />
  </Target>
</Project>
